# Python job agent -> Auth0 -> remote MCP
JOB_PERSISTENCE_MODE=remote
JOB_MCP_URL=https://jay-job-mcp-michaeltchueng-2909s-projects.vercel.app/api/mcp

AUTH0_TOKEN_URL=https://YOUR_TENANT.us.auth0.com/oauth/token
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://jay-job-mcp-michaeltchueng-2909s-projects.vercel.app/api/mcp
AUTH0_SCOPES=jobs:read jobs:write jobs:worker

# OpenAI discovery (Responses API + web_search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# DISCOVERY_MAX_JOBS=100
# DISCOVERY_TIMEOUT_SECONDS=180
# DISCOVERY_MAX_RETRIES=2
# DISCOVERY_TIME_ZONE=America/Los_Angeles

# Local development fallback (SQLite FastMCP):
# JOB_PERSISTENCE_MODE=local

# Milestone 4A - automatic discovery inbox processing (GitHub Actions / CLI)
# DISCOVERY_INBOX_BATCH_LIMIT=5
# DISCOVERY_INBOX_STALE_PROCESSING_MINUTES=60
# DISCOVERY_INBOX_FAIL_WORKFLOW_ON_BATCH_FAILURE=true
# DISCOVERY_INBOX_WORKER_IDENTITY=github-actions
# Repository variable (GitHub): DISCOVERY_INBOX_SCHEDULE_ENABLED=true
#
# Auth0 permissions (manual setup after deploy - do not automate here):
#   Worker M2M: jobs:read jobs:write jobs:worker  (never jobs:delete / jobs:revert unless needed)
#   ChatGPT connector: jobs:read jobs:write jobs:revert  (never jobs:worker / jobs:delete)

# Milestone 5 - automatic job discovery producer (GitHub Actions / CLI)
# Repository variable (GitHub): AUTO_DISCOVERY_SCHEDULE_ENABLED=true
# Separate limits (legacy AUTO_DISCOVERY_MAX_COMPANIES / AUTO_DISCOVERY_MAX_CANDIDATES_PER_COMPANY
# remain honored as fallbacks for the first two):
# AUTO_DISCOVERY_MAX_COMPANIES_PER_RUN=5
# AUTO_DISCOVERY_MAX_LISTINGS_PER_COMPANY=100   # lightweight listings considered per company
# AUTO_DISCOVERY_TOP_CANDIDATES_PER_COMPANY=5   # profile-ranked candidates fetched/evaluated (1-5)
# AUTO_DISCOVERY_MAX_EVALS_PER_RUN=15           # new LLM evaluations per run
# AUTO_DISCOVERY_MAX_BATCHES_PER_RUN=3
# AUTO_DISCOVERY_MAX_JOBS_PER_BATCH=5
# AUTO_DISCOVERY_MIN_RANK_SCORE=20              # deterministic title/location relevance floor
# AUTO_DISCOVERY_MAX_VERIFICATIONS_PER_RUN=5    # company candidates verified per run
# Repository variable (GitHub): AUTO_DISCOVERY_EXPANSION_ENABLED=false disables company expansion
# JOB_SEARCH_PROFILE_PATH=data/job_search_profile.json  # active persona (profile_id + profile_version)
# DASHBOARD_PROFILE_ID=jay
# DASHBOARD_PROFILE_VERSION=jay-ai-v1
# AUTO_DISCOVERY_WORKER_IDENTITY=github-actions
# AUTO_DISCOVERY_LLM_PROVIDER=  # optional override: gemini | groq | openai
# Prefer free-tier keys when available (resolve order: gemini > groq > openai unless overridden)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_API_KEY=
# OPENAI_API_KEY=  # already documented above for discovery; reused for gpt-fit-v2 when selected
# Description retention preview only (production cleanup stays disabled):
# AUTO_DISCOVERY_DESCRIPTION_RETENTION_DAYS=60

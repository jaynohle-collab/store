# Auth0 permissions (manual setup after deploy — do not automate here):
#   Worker M2M: jobs:read jobs:write jobs:worker  (never jobs:delete / jobs:revert unless needed)
#   ChatGPT connector: jobs:read jobs:write jobs:revert  (never jobs:worker / jobs:delete)


# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---------------------------------------------------------------------------
# MCP Auth0 API (resource server / JWT validation for /api/mcp)
# Issuer must match the "iss" claim on access tokens (include trailing slash if Auth0 uses one).
# Do NOT reuse these for the dashboard Regular Web Application.
# ---------------------------------------------------------------------------
AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://YOUR_MCP_HOST/api/mcp

# Public base URL of this MCP deployment (no trailing /api/mcp)
MCP_SERVER_URL=https://YOUR_MCP_HOST

# Optional: explicit JWKS URL. Defaults to ${AUTH0_ISSUER}/.well-known/jwks.json
# AUTH0_JWKS_URL=

# NOTE: The MCP server validates inbound JWTs via JWKS.
# It does NOT need AUTH0_CLIENT_SECRET for bearer validation.

# ---------------------------------------------------------------------------
# Dashboard Auth0 Regular Web Application (@auth0/nextjs-auth0 v4)
# Create a SEPARATE Auth0 application (type: Regular Web Application).
# Callback URL:  ${APP_BASE_URL}/auth/callback
# Logout URL:    ${APP_BASE_URL}
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_DASHBOARD_WEB_APP_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_DASHBOARD_WEB_APP_CLIENT_SECRET
# Long random secret used to encrypt the session cookie (e.g. openssl rand -hex 32)
AUTH0_SECRET=GENERATE_A_LONG_RANDOM_SECRET
APP_BASE_URL=http://localhost:3000

# Comma-separated allowlist for this personal dashboard (lowercase matching)
DASHBOARD_ALLOWED_EMAILS=you@example.com

# IANA timezone for dashboard "today" metrics (stored timestamps remain TIMESTAMPTZ)
DASHBOARD_TIME_ZONE=America/Los_Angeles

# Active evaluation generation shown in the dashboard (historical rows kept intact)
DASHBOARD_SCORING_VERSION=profile-v1
DASHBOARD_PROFILE_VERSION=jay-ai-v1

# Point-score threshold for High Match counts/labels only (0-100 profile-v1 scale)
# DASHBOARD_HIGH_MATCH_THRESHOLD=70

# Max jobs accepted by submit_discovery_batch (default 100)
# DISCOVERY_MAX_JOBS=100

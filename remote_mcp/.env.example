# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---------------------------------------------------------------------------
# MCP Auth0 API (resource server / JWT validation for /api/mcp)
# Issuer must match the "iss" claim on access tokens (include trailing slash if Auth0 uses one).
# Do NOT reuse these for the dashboard Regular Web Application.
# ---------------------------------------------------------------------------
AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://YOUR_MCP_HOST/api/mcp

# Public base URL of this MCP deployment (no trailing /api/mcp)
MCP_SERVER_URL=https://YOUR_MCP_HOST

# Optional: explicit JWKS URL. Defaults to ${AUTH0_ISSUER}/.well-known/jwks.json
# AUTH0_JWKS_URL=

# NOTE: The MCP server validates inbound JWTs via JWKS.
# It does NOT need AUTH0_CLIENT_SECRET for bearer validation.

# ---------------------------------------------------------------------------
# Dashboard Auth0 Regular Web Application (@auth0/nextjs-auth0 v4)
# Create a SEPARATE Auth0 application (type: Regular Web Application).
# Callback URL:  ${APP_BASE_URL}/auth/callback
# Logout URL:    ${APP_BASE_URL}
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_DASHBOARD_WEB_APP_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_DASHBOARD_WEB_APP_CLIENT_SECRET
# Long random secret used to encrypt the session cookie (e.g. openssl rand -hex 32)
AUTH0_SECRET=GENERATE_A_LONG_RANDOM_SECRET
APP_BASE_URL=http://localhost:3000

# Comma-separated allowlist for this personal dashboard (lowercase matching)
DASHBOARD_ALLOWED_EMAILS=you@example.com

# IANA timezone for dashboard "today" metrics (stored timestamps remain TIMESTAMPTZ)
DASHBOARD_TIME_ZONE=America/Los_Angeles

# Active evaluation generation shown in the dashboard (historical rows kept intact)
DASHBOARD_SCORING_VERSION=profile-v1
DASHBOARD_PROFILE_VERSION=jay-ai-v1

# Point-score threshold for High Match counts/labels only (0-100 profile-v1 scale)
# DASHBOARD_HIGH_MATCH_THRESHOLD=70

# Max jobs accepted by submit_discovery_batch (default 100)
# DISCOVERY_MAX_JOBS=100
# DISCOVERY_SOURCE_CLAIM_TIMEOUT_MINUTES=60
# DISCOVERY_SOURCE_MAX_ATTEMPTS=3
# DISCOVERY_SOURCE_CHECKPOINT_MAX_BYTES=65536

# Require every submit_discovery_batch job to reference a stored GPT admission
# evaluation (QUALIFIED, score >= 70, matching identity/version/hash).
# Default false when unset. Enables only when set exactly to true (case-insensitive).
# Values like false, 0, yes, or 1 do NOT enable the gate.
# Production already runs with this true — never temporarily disable it during v2 rollout.
# DISCOVERY_REQUIRE_GPT_EVALUATION=true

# Milestone 3A quality gates (default off until cutover).
# Any of these being enabled implicitly requires stored GPT evidence even if
# DISCOVERY_REQUIRE_GPT_EVALUATION is false (never silently accept without evidence).
#
# Correct production rollout (GPT enforcement already on):
#   1) Apply migration 008
#   2) Deploy code while keeping DISCOVERY_REQUIRE_GPT_EVALUATION=true
#   3) Leave DISCOVERY_REQUIRED_EVALUATION_VERSION absent or gpt-fit-v1
#   4) Smoke-test compute_discovery_description_hashes + gpt-fit-v2 evidence recording
#   5) Set ALL v2 settings together, then redeploy once:
#        DISCOVERY_REQUIRED_EVALUATION_VERSION=gpt-fit-v2
#        DISCOVERY_REQUIRE_REMOTE_US=true
#        DISCOVERY_REQUIRE_DIRECT_POSTING_URL=true
#        DISCOVERY_REQUIRE_DESCRIPTION_HASH=true
#   6) Refresh/recreate the ChatGPT plugin
#   7) Run negative + positive smoke tests
# Cycle 2 prompts must explicitly pass evaluation_version=gpt-fit-v2 (default remains v1).
# DISCOVERY_REQUIRED_EVALUATION_VERSION=
# DISCOVERY_REQUIRE_REMOTE_US=false
# DISCOVERY_REQUIRE_DIRECT_POSTING_URL=false
# DISCOVERY_REQUIRE_DESCRIPTION_HASH=false

# Milestone 4 — inbox stale-claim recovery (minutes a processing claim may linger)
# DISCOVERY_INBOX_STALE_PROCESSING_MINUTES=60
#
# Auth0 API permissions to create manually after deploy (placeholders only here):
#   jobs:worker  — GitHub Actions / Python inbox worker M2M
#   jobs:revert  — ChatGPT / operators for revert_discovery_batch only
# ChatGPT connector must NOT receive jobs:worker or jobs:delete.

# Milestone 5 � company registry / automatic discovery control plane (MCP + Neon)
# Migration: 010_automatic_discovery_companies.sql
# Producer runs in Python/GitHub Actions; MCP stores registry + run metrics only.
# Soft storage warning uses ~80% of Neon free-tier soft limit (observability only).
# AUTO_DISCOVERY_STORAGE_SOFT_LIMIT_BYTES=536870912
# Preview description retention (dry-run MCP tool; cleanup not enabled):
# AUTO_DISCOVERY_DESCRIPTION_RETENTION_DAYS=60
